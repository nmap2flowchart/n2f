{
  "name": "NMAP2Flowchart – nmap scan to network diagram",
  "short_name": "NMAP2Flowchart",
  "description": "Turn nmap scans into editable network diagrams, entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080b10",
  "theme_color": "#0b1118",
  "icons": [
    { "src": "./favicon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" },
    { "src": "./icon-maskable.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "maskable" },
    { "src": "./apple-touch-icon.png", "type": "image/png", "sizes": "180x180" }
  ]
}
